Pila::Pila(){
	tope = NULL; 
}
void Pila::push() {
	int valor; 
	string valor2; 

	Nodo* aux = new Nodo; 
	system("cls"); 
	cout << "Ingresa el ID del proceso" << endl; 
	cin >> valor; 
	cout << "Ingresa el nombre del proceso" << endl; 
	cin.ignore(); 
	getline(cin, valor2); 
	aux -> dato = valor; 
	aux->nombre = valor2; 
	aux->sig = NULL; 
	if (tope != NULL)
		aux->sig = tope; 
	tope = aux; 
	cout << "nuevo proceso insertado" << endl; 
}

