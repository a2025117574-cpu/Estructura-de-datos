#include <iostream>
using namespace std; 
// probando la cola

int main()
{
    int d, opcion;
    Queue q;

    do {
        cout << "---MENU---" << endl; 
        cout << "1. Push" << endl;
        cout << "2.POP" << endl; 
        cout << "3. Vacia" << endl; 
        cout << "4. tamanio" << endl; 
        cout << "0. Salir" << endl; 

        switch (opcion)
        {
        case 1:
            for (d = 'A'; d <= 'Z'; d++) q.put(d);
            break;
        case 2:
            while (q.size()) {
                cout << (char)q.get() << " ";
            }
        case 3:
            if (q.empty())
                cout << "La cola esta vacia" << endl;
            else
                cout << "La cola no esta vacia" << endl; 
            break; 
        case 4: 
            cout << "Items= " << q.size() << endl; 

        default:
            break;
        }
    }

    

    cout << "Items = " << q.size() << endl;

    while (q.size()) {
        cout << (char)q.get() << " ";
    }

    cout << "\nPara terminar oprima <Enter> ...";
    cin.get();
    return 0;

}
